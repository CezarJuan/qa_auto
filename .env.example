# Copie para .env e preencha. Nunca coloque a chave real neste arquivo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OLLAMA_MODEL=llama3.1:8b
OLLAMA_HOST=http://localhost:11434
# Tempo limite de cada chamada ao LLM, em segundos
QA_TIMEOUT_LLM=180
# Orçamento total de uma geração (todas as tentativas), em segundos.
# A interface aguarda este valor mais 15 s.
QA_ORCAMENTO_GERACAO=360
# Semente fixa para a extração (Ollama e Gemini), junto com temperatura 0
QA_SEMENTE=42
# Por quanto tempo o Ollama mantém o modelo na memória após o aquecimento
QA_OLLAMA_KEEP_ALIVE=30m
# Use 0 para não aquecer o Ollama ao subir a API
QA_AQUECER_OLLAMA=1
