# Copie para .env e preencha. Nunca coloque a chave real neste arquivo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OLLAMA_MODEL=llama3.1:8b
OLLAMA_HOST=http://localhost:11434
# Tempo limite de cada chamada ao LLM, em segundos
QA_TIMEOUT_LLM=180
# Orçamento total de uma geração (todas as tentativas), em segundos.
# A interface aguarda este valor mais 15 s.
QA_ORCAMENTO_GERACAO=360
# Semente fixa para a extração (Ollama e Gemini), junto com temperatura 0
QA_SEMENTE=42
# Por quanto tempo o Ollama mantém o modelo na memória após o aquecimento
QA_OLLAMA_KEEP_ALIVE=30m
# Use 0 para não aquecer o Ollama ao subir a API
QA_AQUECER_OLLAMA=1

# ---------------------------------------------------------------- Anthropic (Claude)
# Chave da API; nunca coloque a chave real neste arquivo.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Esforço do modelo (low, medium, high, xhigh, max); vazio não envia
ANTHROPIC_EFFORT=medium
# 1: se o Claude recusar por segurança, a API reexecuta em outro modelo Claude; 0 desliga
ANTHROPIC_FALLBACK_RECUSA=1

# ---------------------------------------------------------------- Servidor compatível com OpenAI
# LM Studio: http://localhost:1234/v1 · Ollama: http://localhost:11434/v1 · OpenRouter: https://openrouter.ai/api/v1
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
# json_schema (esquema estrito), json_object (só JSON) ou nenhum
OPENAI_COMPAT_MODO_ESQUEMA=json_schema
# 1 se o servidor respeita temperatura 0 e semente (resultado marcado como determinístico)
OPENAI_COMPAT_DETERMINISTICO=0
